{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "companion-toast",
  "description": "陪伴建议悬浮窗的最小权限集",
  "windows": [
    "companion-toast"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:event:allow-listen",
    "core:window:default",
    "core:window:allow-hide",
    "core:window:allow-start-dragging"
  ]
}

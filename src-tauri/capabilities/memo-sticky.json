{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "memo-sticky",
  "description": "备忘桌面便签窗的最小权限集",
  "windows": [
    "memo-sticky"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:event:allow-listen",
    "core:window:default",
    "core:window:allow-hide",

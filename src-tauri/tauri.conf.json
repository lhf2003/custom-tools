{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "FlowHub",
  "version": "0.4.1",
  "identifier": "com.flowhub.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FlowHub",
        "width": 800,
        "height": 500,
        "minWidth": 600,
        "minHeight": 50,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "shadow": false
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/com.flowhub.app/plugins/**",
          "$APPDATA/com.flowhub.app/clipboard-images/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "resources": {
      "resources/uv.exe": "uv.exe",
      "../sidecar/wemm/server.py": "sidecar/wemm/server.py",
      "../sidecar/wemm/pyproject.toml": "sidecar/wemm/pyproject.toml",
      "../sidecar/wemm/download_model.py": "sidecar/wemm/download_model.py"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENGNEE0MzY5NDc1OUFBN0QKUldSOXFsbEhhVU5Lejk1eUN3V3ZJTTBMZm1uQlZzZUZ6NlZJNkFxaHBIRXRMSlU3YjFzb1pjYzUK",
      "endpoints": [
        "https://github.com/lhf2003/custom-tools/releases/latest/download/latest.json",
        "https://gh-proxy.com/https://github.com/lhf2003/custom-tools/releases/latest/download/latest.json",
        "https://ghfast.top/https://github.com/lhf2003/custom-tools/releases/latest/download/latest.json"
      ]
    },
    "process": {},
    "opener": {}
  }
}
